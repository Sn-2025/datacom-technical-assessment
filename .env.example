# Copy to .env. The file is ignored by Git and Docker build context.
PROFILE=official_test
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5.4-nano
OPENAI_API_KEY=
# A local mounted file is also supported: OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# For the assessment profile, use its supplied gateway URL and credential together.

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BACKEND=local
EMBEDDING_DIMENSIONS=384
# To use official API embeddings, set EMBEDDING_BACKEND=openai and EMBEDDING_MODEL=text-embedding-3-small.
# EMBEDDING_API_KEY=  # Separate official credential when generation uses another provider.
EMBEDDING_THREADS=2
CHUNK_TOKENS=320
CHUNK_OVERLAP=40
RETRIEVAL_MODE=hybrid
SANDBOX_IMAGE=assessment-sandbox:local
SANDBOX_TIMEOUT_S=20
# Set for a shared API deployment. Local ports bind to loopback by default.
APP_ACCESS_TOKEN=
