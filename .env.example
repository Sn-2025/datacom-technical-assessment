# Copy to .env. The file is ignored by Git and Docker build context.
# Generation defaults to the assessment gateway. Put the supplied OPENAI_API_KEY in .env; do not commit it.
PROFILE=assessment
OPENAI_BASE_URL=https://aiunifier.lemonforest-8302e80c.australiaeast.azurecontainerapps.io
MODEL_NAME=gpt-5.4-nano
OPENAI_API_KEY=
# A local mounted file is also supported: OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# Optional local development against official OpenAI: PROFILE=official_test OPENAI_BASE_URL=https://api.openai.com/v1

# Official OpenAI embeddings remain separate from generation. Required when generation uses the assessment gateway.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BACKEND=openai
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_KEY=
EMBEDDING_THREADS=2
CHUNK_TOKENS=320
CHUNK_OVERLAP=40
RETRIEVAL_MODE=hybrid
SANDBOX_IMAGE=assessment-sandbox:local
SANDBOX_TIMEOUT_S=20
# Set for a shared API deployment. Local ports bind to loopback by default.
APP_ACCESS_TOKEN=
